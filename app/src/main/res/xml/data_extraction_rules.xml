<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the TomTom key stays on this phone, in cloud backups and device transfers alike. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
